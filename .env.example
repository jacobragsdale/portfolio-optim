# Copy to .env and fill in. Every variable is required; run with `uv run --env-file .env optim ...`.
OPTIM_ORACLE__DSN=dbhost.example.com:1521/ANALYTICS
OPTIM_ORACLE__USER=optim
OPTIM_ORACLE__PASSWORD=change-me
OPTIM_MSSQL__CONNECTION_STRING=Server=sqlhost.example.com;Database=Accounts;Authentication=ActiveDirectoryDefault;Encrypt=yes
OPTIM_SIGNALS__URL=https://signals.example.com
OPTIM_OMS__URL=https://oms.example.com/api
# `none` caches datasets in process memory instead of Redis.
OPTIM_REDIS_URL=none
OPTIM_SNAPSHOT_DIR=./snapshots
