# Copy to .env and fill in. Every variable is required unless commented out; run with `uv run --env-file .env optim ...`.
OPTIM_ORACLE__DSN=dbhost.example.com:1521/ANALYTICS
OPTIM_ORACLE__USER=optim
OPTIM_ORACLE__PASSWORD=change-me
# `thin` needs no client libraries; `thick` loads Oracle Instant Client, which some databases need.
OPTIM_ORACLE__MODE=thin
# Thick mode only, where Instant Client is not on the library path.
# OPTIM_ORACLE__CLIENT_LIB_DIR=/opt/oracle/instantclient
# The primary, not a readable secondary: working holdings must include the trades just booked. Read-only transactions
# use snapshot isolation, which the database must allow (ALLOW_SNAPSHOT_ISOLATION ON).
OPTIM_MSSQL__CONNECTION_STRING=Server=sqlhost.example.com;Database=Accounts;Authentication=ActiveDirectoryDefault;Encrypt=yes
OPTIM_SIGNALS__URL=https://signals.example.com
# Per source: how many queries or calls this process sends at once (the rest wait their turn), the deadline in seconds
# on each, and the most rows one may return before it fails. SQL Server applies the deadline to a query's execute and
# to its fetch; Oracle, to each round trip. A read-only transaction holds one of its source's slots until it ends.
OPTIM_ORACLE__MAX_CONCURRENT=4
OPTIM_ORACLE__TIMEOUT_S=240
OPTIM_ORACLE__MAX_ROWS=2000000
OPTIM_MSSQL__MAX_CONCURRENT=4
OPTIM_MSSQL__TIMEOUT_S=240
OPTIM_MSSQL__MAX_ROWS=2000000
OPTIM_SIGNALS__MAX_CONCURRENT=2
OPTIM_SIGNALS__TIMEOUT_S=240
OPTIM_SIGNALS__MAX_ROWS=500000
# A path or URL, read and written through pyarrow.fs, such as abfs://container@account.dfs.core.windows.net/optim.
OPTIM_SNAPSHOT_ROOT=snapshots
# Optional: the dataset cache, a path or URL. Without it every dataset is read live; `optim warm` needs it.
# OPTIM_CACHE_ROOT=cache
# Solver processes per run: match the Job's CPU request. 1 solves in the calling process.
OPTIM_WORKERS=1
# Optional. Logs are JSON lines on stderr; `text` reads better in a terminal. INFO times every load, query, HTTP call
# and solve; DEBUG adds every rule.
# OPTIM_LOG_LEVEL=INFO
# OPTIM_LOG_FORMAT=json
