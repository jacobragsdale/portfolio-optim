# Copy to .env and fill in. Every variable is required; run with `uv run --env-file .env optim ...`.
OPTIM_ORACLE_DSN=dbhost.example.com:1521/ANALYTICS
OPTIM_ORACLE_USER=optim
OPTIM_ORACLE_PASSWORD=change-me
OPTIM_MSSQL_CONNECTION_STRING=Server=sqlhost.example.com;Database=Accounts;Authentication=ActiveDirectoryDefault;Encrypt=yes
OPTIM_SIGNALS_URL=https://signals.example.com
OPTIM_OMS_URL=https://oms.example.com/api
OPTIM_REDIS_URL=none
OPTIM_SNAPSHOT_DIR=./snapshots
