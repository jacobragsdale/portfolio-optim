# Copy to .env and fill in. Every variable is required unless commented out; run with `uv run --env-file .env optim ...`.
OPTIM_ORACLE__DSN=dbhost.example.com:1521/ANALYTICS
OPTIM_ORACLE__USER=optim
OPTIM_ORACLE__PASSWORD=change-me
OPTIM_MSSQL__CONNECTION_STRING=Server=sqlhost.example.com;Database=Accounts;Authentication=ActiveDirectoryDefault;Encrypt=yes
OPTIM_SIGNALS__URL=https://signals.example.com
# `none` reads every dataset live. `optim warm` needs Redis.
OPTIM_REDIS_URL=none
OPTIM_SNAPSHOT_DIR=./snapshots
# Solver processes per run: match the Job's CPU request. 1 solves in the calling process.
OPTIM_WORKERS=1
# Optional. Logs are JSON lines on stderr; `text` reads better in a terminal. DEBUG adds every load, query, HTTP call,
# rule and solve, with timings.
# OPTIM_LOG_LEVEL=INFO
# OPTIM_LOG_FORMAT=json
