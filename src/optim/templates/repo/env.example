# Copy to .env, and to .env.qa and .env.prod for those environments, and set what each reads; git ignores them all. A
# model's main.py names the file it reads, as env=".env"; the command line reads one with
# `uv run --env-file .env optim ...`. A source left out cannot be read, so a run on the fixture needs nothing here.

# Where `optim run` saves its snapshots, and where a replay finds a run by its id: a path, or a URL read through
# pyarrow.fs, such as abfs://container@account.dfs.core.windows.net/optim. A run from main.py saves in the repo's
# snapshots/ whatever this says; in .env.prod, set production's, read-only, to replay its runs.
OPTIM_SNAPSHOT_ROOT=snapshots
# The dataset cache, a path or URL. Without it every dataset is read live; `optim warm` needs it.
# OPTIM_CACHE_ROOT=cache
# Worker processes per run; 1 decides in the calling process, where a breakpoint stops.
# OPTIM_WORKERS=1

# Oracle. `thin` needs no client libraries; `thick` loads Oracle Instant Client, which some databases need.
# OPTIM_ORACLE__DSN=dbhost.example.com:1521/ANALYTICS
# OPTIM_ORACLE__USER=optim
# OPTIM_ORACLE__PASSWORD=change-me
# OPTIM_ORACLE__MODE=thin
# OPTIM_ORACLE__CLIENT_LIB_DIR=/opt/oracle/instantclient
# OPTIM_ORACLE__MAX_CONCURRENT=4
# OPTIM_ORACLE__TIMEOUT_S=240
# OPTIM_ORACLE__MAX_ROWS=2000000

# SQL Server: the primary, not a readable secondary, since holdings must include the trades just booked. Read-only
# transactions use snapshot isolation, which the database must allow (ALLOW_SNAPSHOT_ISOLATION ON).
# OPTIM_MSSQL__CONNECTION_STRING=Server=sqlhost.example.com;Database=Accounts;Authentication=ActiveDirectoryDefault;Encrypt=yes
# OPTIM_MSSQL__MAX_CONCURRENT=4
# OPTIM_MSSQL__TIMEOUT_S=240
# OPTIM_MSSQL__MAX_ROWS=2000000

# A REST API that answers a GET with a list of records, such as the signals API.
# OPTIM_REST__URL=https://signals.example.com
# OPTIM_REST__MAX_CONCURRENT=2
# OPTIM_REST__TIMEOUT_S=240
# OPTIM_REST__MAX_ROWS=500000

# Logs are JSON lines on stderr from the command line, and text from main.py.
# OPTIM_LOG_LEVEL=INFO
# OPTIM_LOG_FORMAT=json

# Production only: the table `optim run` writes accepted portfolios' orders to, with a login that may insert. Without
# it, orders stay in the run's snapshot. A run from main.py never writes orders.
# OPTIM_ORDERS__CONNECTION_STRING=Server=sqlhost.example.com;Database=Trading;Authentication=ActiveDirectoryDefault;Encrypt=yes
# OPTIM_ORDERS__TABLE=trading.orders
